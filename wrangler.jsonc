{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ngan-vn",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  // Custom domains — uncomment once the ngan.vn zone is ACTIVE on Cloudflare
  // (registrar nameservers → jake/kay.ns.cloudflare.com). Attaching while the
  // zone is pending fails the whole deploy.
  // "routes": [
  //   { "pattern": "ngan.vn", "custom_domain": true },
  //   { "pattern": "www.ngan.vn", "custom_domain": true }
  // ],
  "observability": {
    "enabled": true
  },
  // Fully prerendered static site — assets only, no worker script needed.
  "assets": {
    "directory": "./dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
